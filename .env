DATABASE_URL="file:./dev.db"

# Python PDF 解析服务地址
PARSER_SERVICE_URL="http://127.0.0.1:8000"

# 本地文件存储根目录（相对于项目根）
STORAGE_DIR="./storage"

# ============================================================
# LLM 配置（P2 启用）
#
# 设计原则：不绑定任何具体模型，换 provider / 模型只改这几个变量。
#
# LLM_PROVIDER:
#   mock              —— 默认值。本地启发式抽取，无需 API Key，
#                        用于跑通链路 / 演示。UI 会显著标注"演示模式"。
#   openai-compatible —— 任何兼容 OpenAI /chat/completions 协议的服务，
#                        包括 OpenAI、DeepSeek、通义千问、Moonshot、
#                        vLLM、Ollama、One-API 等。
#
# ── 示例 A：OpenAI ──
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
#
# ── 示例 B：DeepSeek ──
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1

# ── 示例 D：腾讯云 TokenHub（本项目当前采用）──
# 混元 Hy 系列，OpenAI 兼容协议。
#
# ⚠️ TokenHub 有**两个互不通用**的入口，Key 也不通用 —— 这是最容易踩的坑：
#    在线推理（按量） → https://tokenhub.tencentmaas.com/v1
#                        Key 来自「TokenHub → API Key 管理」
#    Token Plan（包月）→ https://api.lkeap.cloud.tencent.com/plan/v3
#                        Key 来自「TokenHub → Token Plan」页
#    用错入口的表现：api.lkeap 一律返回 401 {"code":"not_authorized"}，
#    且**不带 Key 时也是同样的错**，完全看不出问题在哪。
#    拿不准先跑 node scripts/llm-check.mjs，它会横比两个入口。
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=deepseek/deepseek-flash
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
#
# ── 示例 C：本地 Ollama ──
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# ============================================================

# ════════════════════════════════════════════════════════════
#  ↓↓↓ 下面 5 行是真正生效的配置。改完先跑 node scripts/llm-check.mjs 验连通 ↓↓↓
# ════════════════════════════════════════════════════════════

LLM_PROVIDER=openai-compatible
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-f69df8c24ff14cc588687a2a6311d53a
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_MS=120000
